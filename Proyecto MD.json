        "jsonOutput": "={\n  \"titulo\": \"{{ $json.output ? JSON.parse($json.output.endsWith('}') ? $json.output : $json.output + '}').titulo : '' }}\",\n  \"url\": \"{{ $json.output ? JSON.parse($json.output.endsWith('}') ? $json.output : $json.output + '}').url : '' }}\",\n  \"resumen\": \"{{ $json.output ? JSON.parse($json.output.endsWith('}') ? $json.output : $json.output + '}').resumen : '' }}\",\n  \"sentimiento\": \"{{ $json.output ? JSON.parse($json.output.endsWith('}') ? $json.output : $json.output + '}').sentimiento : '' }}\"\n}",
